APP_NAME="Beauty Salon API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Bearer token required by every /api endpoint.
API_TOKEN=change-me

# Uses database/database.sqlite (created below) unless DB_CONNECTION is switched to mysql.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

CACHE_STORE=file
