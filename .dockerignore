# Keep the build context deterministic: the image must build the same way on CI
# (tracked files only) as it does on a developer machine, and must not inherit
# local state such as a stray .env, vendor/, compiled views, or a sqlite file.
.git
.gitattributes
.github
.editorconfig
.env
.env.backup
.env.production
.phpunit.cache
.phpunit.result.cache

/vendor
/node_modules
/tests
/phpunit.xml
/Procfile
/railway.json
/docker-compose.yml
/.trivyignore.yaml
/README.md
/TASK.md

# Runtime state, all regenerated during the build.
/storage/framework/cache/data/*
/storage/framework/views/*
/storage/logs/*
/storage/api-docs/*.json
/bootstrap/cache/*.php
/database/*.sqlite*
